struct ConstraintRequestQueueView: View {
    @Environment(CarpoolStore.self) private var store

    var body: some View {
        List {
            let pending = store.constraintRequests.filter { $0.status == .pending }
            if pending.isEmpty {
                ContentUnavailableView(
                    "No pending requests",
                    systemImage: "checkmark.seal.fill",
                    description: Text("New parent availability requests will appear here for any owner or admin.")
                )
            }
            ForEach(pending.sorted { $0.submittedAt < $1.submittedAt }) { request in
                NavigationLink { ConstraintReviewView(requestID: request.id) } label: {
                    VStack(alignment: .leading, spacing: 6) {
                        HStack {
                            Text(request.parentName).font(.headline)
                            Spacer()
                            Text("\(request.existingAssignmentsAffected) affected")
                                .font(.caption.bold()).foregroundStyle(KCPTheme.orange)
                        }
                        Text("Drop: \(weekdaySummary(request.requestedDropWeekdays))")
                            .font(.caption).foregroundStyle(.secondary)
                        Text("Pickup: \(weekdaySummary(request.requestedPickupWeekdays))")
                            .font(.caption).foregroundStyle(.secondary)
                        Text(request.submittedAt.formatted(date: .abbreviated, time: .shortened))
                            .font(.caption2).foregroundStyle(.tertiary)
                    }
                    .padding(.vertical, 4)
                }
            }
        }
        .navigationTitle("Approval Queue")
    }
}

private struct ConstraintReviewView: View {
    @Environment(CarpoolStore.self) private var store
    @Environment(\.dismiss) private var dismiss
    let requestID: UUID
    @State private var reviewNote = ""

    private var request: ConstraintChangeRequest? {
        store.constraintRequests.first { $0.id == requestID }
    }

    var body: some View {
        Form {
            if let request {
                Section("Requested by \(request.parentName)") {
                    LabeledContent("Current drop", value: weekdaySummary(request.previousDropWeekdays))
                    LabeledContent("Requested drop", value: weekdaySummary(request.requestedDropWeekdays))
                    LabeledContent("Current pickup", value: weekdaySummary(request.previousPickupWeekdays))
                    LabeledContent("Requested pickup", value: weekdaySummary(request.requestedPickupWeekdays))
                    LabeledContent("Schedule impact", value: "\(request.existingAssignmentsAffected) future trips")
                    if !request.notes.isEmpty { Text(request.notes).font(.footnote) }
                }
                Section("Admin note") {
                    TextField("Optional approval/rejection note", text: $reviewNote, axis: .vertical)
                }
                Section {
                    Button("Approve and create schedule version") {
                        Task {
                            await store.reviewConstraintRequest(requestID, approve: true, note: reviewNote)
                            dismiss()
                        }
                    }
                    .buttonStyle(.borderedProminent)
                    .tint(KCPTheme.green)

                    Button("Reject request", role: .destructive) {
                        Task {
                            await store.reviewConstraintRequest(requestID, approve: false, note: reviewNote)
                            dismiss()
                        }
                    }
                }
            }
        }
        .navigationTitle("Review Request")
    }
}

