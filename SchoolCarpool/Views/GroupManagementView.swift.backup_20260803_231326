private struct GroupMembersView: View {
    @Environment(CarpoolStore.self) private var store

    var body: some View {
        List {
            ForEach(store.groupMembers.sorted { lhs, rhs in
                if lhs.role == rhs.role { return lhs.parentName < rhs.parentName }
                return roleRank(lhs.role) < roleRank(rhs.role)
            }) { member in
                VStack(alignment: .leading, spacing: 8) {
                    HStack {
                        ZStack {
                            Circle().fill(KCPTheme.parentColor(member.parentName).opacity(0.14))
                            Text(initials(member.parentName)).font(.caption.bold())
                                .foregroundStyle(KCPTheme.parentColor(member.parentName))
                        }
                        .frame(width: 40, height: 40)

                        VStack(alignment: .leading, spacing: 2) {
                            Text(member.parentName).font(.headline)
                            Text("\(member.childName), Grade \(member.grade)")
                                .font(.caption).foregroundStyle(.secondary)
                        }
                        Spacer()
                        Label(member.role.displayName, systemImage: member.role.symbol)
                            .font(.caption.bold())
                            .foregroundStyle(member.role == .owner ? KCPTheme.orange : KCPTheme.violet)
                    }

                    if store.isCurrentUserAdmin,
                       member.parentName != store.currentParentName,
                       member.role != .owner {
                        Menu("Change role") {
                            Button("Parent") { Task { await store.updateMemberRole(parentName: member.parentName, role: .parent) } }
                            Button("Admin") { Task { await store.updateMemberRole(parentName: member.parentName, role: .admin) } }
                            Button("Viewer") { Task { await store.updateMemberRole(parentName: member.parentName, role: .viewer) } }
                        }
                        .font(.caption.bold())
                    }
                }
                .padding(.vertical, 4)
            }
        }
        .navigationTitle("Members & Admins")
    }

    private func roleRank(_ role: GroupRole) -> Int {
        switch role { case .owner: return 0; case .admin: return 1; case .parent: return 2; case .viewer: return 3 }
    }

    private func initials(_ name: String) -> String {
        name.split(separator: " ").prefix(2).compactMap(\.first).map(String.init).joined().uppercased()
    }
}

