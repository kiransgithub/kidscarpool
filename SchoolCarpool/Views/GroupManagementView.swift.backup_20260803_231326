let kcpWeekdays = [(2, "Monday"), (3, "Tuesday"), (4, "Wednesday"), (5, "Thursday"), (6, "Friday")]

func weekdaySummary(_ days: Set<Int>) -> String {
    if days.isEmpty { return "None" }
    return kcpWeekdays.filter { days.contains($0.0) }.map { String($0.1.prefix(3)) }.joined(separator: ", ")
}
