struct MyAvailabilityView: View {
    @Environment(CarpoolStore.self) private var store
    @State private var dropDays: Set<Int> = []
    @State private var pickupDays: Set<Int> = []
    @State private var notes = ""

    var body: some View {
        Form {
            if let approved = store.approvedConstraint(for: store.currentParentName) {
                Section("Currently approved") {
                    LabeledContent("Morning drops", value: weekdaySummary(approved.dropWeekdays))
                    LabeledContent("Afternoon pickups", value: weekdaySummary(approved.pickupWeekdays))
                    LabeledContent("Constraint version", value: "v\(approved.version)")
                }
            }

            if let request = store.latestConstraintRequest(for: store.currentParentName) {
                Section("Latest request") {
                    LabeledContent("Status", value: request.status.displayName)
                    LabeledContent("Submitted", value: request.submittedAt.formatted(date: .abbreviated, time: .shortened))
                    LabeledContent("Estimated affected trips", value: "\(request.existingAssignmentsAffected)")
                    if let reviewer = request.reviewedBy { LabeledContent("Reviewed by", value: reviewer) }
                    if let rejection = request.rejectionReason, !rejection.isEmpty {
                        Text(rejection).font(.footnote).foregroundStyle(KCPTheme.red)
                    }
                }
            }

            availabilitySection(title: "Morning drop availability", selection: $dropDays, color: KCPTheme.orange)
            availabilitySection(title: "Afternoon pickup availability", selection: $pickupDays, color: KCPTheme.violet)
            Section("Notes or preferences") {
                TextField("Example: Thursday preferred", text: $notes, axis: .vertical)
            }
            Section {
                Button(store.isSyncing ? "Submitting…" : "Submit update request") {
                    Task {
                        await store.submitConstraintRequest(
                            dropWeekdays: dropDays,
                            pickupWeekdays: pickupDays,
                            notes: notes
                        )
                    }
                }
                .buttonStyle(.borderedProminent)
                .disabled(store.isSyncing)
            } footer: {
                Text("The approved schedule is not silently overwritten. An admin reviews the request, the database stores the decision, and approval creates a new schedule version.")
            }
        }
        .navigationTitle("My Availability")
        .onAppear {
            if let constraint = store.approvedConstraint(for: store.currentParentName) {
                dropDays = constraint.dropWeekdays
                pickupDays = constraint.pickupWeekdays
                notes = constraint.notes
            } else if let parent = store.parents.first(where: { $0.name == store.currentParentName }) {
                dropDays = parent.effectiveDropWeekdays
                pickupDays = parent.pickupWeekdays
                notes = parent.notes ?? ""
            }
        }
    }

    private func availabilitySection(title: String, selection: Binding<Set<Int>>, color: Color) -> some View {
        Section(title) {
            ForEach(kcpWeekdays, id: \.0) { day, label in
                Toggle(label, isOn: Binding(
                    get: { selection.wrappedValue.contains(day) },
                    set: { enabled in
                        if enabled { selection.wrappedValue.insert(day) }
                        else { selection.wrappedValue.remove(day) }
                    }
                ))
                .tint(color)
            }
        }
    }
}

