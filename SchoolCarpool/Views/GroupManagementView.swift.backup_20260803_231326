import SwiftUI

struct GroupManagementView: View {
    @Environment(CarpoolStore.self) private var store

    var body: some View {
        List {
            if let group = store.activeGroup {
                Section {
                    VStack(alignment: .leading, spacing: 12) {
                        HStack(alignment: .top) {
                            ZStack {
                                RoundedRectangle(cornerRadius: 16, style: .continuous)
                                    .fill(KCPTheme.heroGradient)
                                Image(systemName: "person.3.sequence.fill")
                                    .font(.title2.bold())
                                    .foregroundStyle(.white)
                            }
                            .frame(width: 54, height: 54)

                            VStack(alignment: .leading, spacing: 3) {
                                Text(group.name).font(.headline)
                                Text(group.schoolName).font(.subheadline).foregroundStyle(.secondary)
                                Text("\(group.academicYear) • \(group.code)")
                                    .font(.caption.monospaced()).foregroundStyle(.secondary)
                            }
                            Spacer()
                        }

                        HStack {
                            Label(store.currentRole.displayName, systemImage: store.currentRole.symbol)
                                .font(.caption.bold())
                                .foregroundStyle(roleColor(store.currentRole))
                            Spacer()
                            Label("Schedule v\(group.currentScheduleVersion)", systemImage: "clock.arrow.circlepath")
                                .font(.caption.bold())
                                .foregroundStyle(KCPTheme.violet)
                        }
                    }
                    .padding(.vertical, 4)
                }

                Section("Group setup") {
                    if store.isCurrentUserAdmin {
                        NavigationLink { InviteParentView() } label: {
                            Label("Invite another parent", systemImage: "person.badge.plus")
                        }
                    }
                    NavigationLink { AcceptInvitationView() } label: {
                        Label("Accept an invitation", systemImage: "envelope.open.fill")
                    }
                    NavigationLink { GroupMembersView() } label: {
                        HStack {
                            Label("Members & admins", systemImage: "person.3.fill")
                            Spacer()
                            Text("\(store.groupMembers.filter { $0.status == .active }.count)")
                                .foregroundStyle(.secondary)
                        }
                    }
                    NavigationLink { GroupInvitationsView() } label: {
                        HStack {
                            Label("Invitation history", systemImage: "envelope.fill")
                            Spacer()
                            Text("\(store.groupInvitations.filter { $0.status == .pending }.count) pending")
                                .foregroundStyle(.secondary)
                        }
                    }
                }

                Section("Availability & schedule") {
                    NavigationLink { MyAvailabilityView() } label: {
                        Label("My drop & pickup availability", systemImage: "slider.horizontal.3")
                    }
                    NavigationLink { AllConstraintsView() } label: {
                        Label("All parent constraints", systemImage: "person.3.sequence.fill")
                    }
                    if store.isCurrentUserAdmin {
                        NavigationLink { ConstraintRequestQueueView() } label: {
                            HStack {
                                Label("Constraint approval queue", systemImage: "checklist.checked")
                                Spacer()
                                if store.pendingConstraintCount > 0 {
                                    Text("\(store.pendingConstraintCount)")
                                        .font(.caption.bold())
                                        .foregroundStyle(.white)
                                        .padding(.horizontal, 8)
                                        .padding(.vertical, 4)
                                        .background(KCPTheme.red, in: Capsule())
                                }
                            }
                        }
                    }
                    NavigationLink { ScheduleVersionsView() } label: {
                        Label("Schedule versions", systemImage: "square.stack.3d.up.fill")
                    }
                    if store.isCurrentUserAdmin {
                        Button {
                            store.regenerateScheduleFromConstraints()
                        } label: {
                            Label("Generate & publish schedule", systemImage: "calendar.badge.checkmark")
                        }
                        .disabled(!scheduleReady)

                        if !scheduleReady {
                            Text(scheduleReadinessMessage)
                                .font(.footnote)
                                .foregroundStyle(.secondary)
                        }
                    }
                }

                Section("Accountability") {
                    NavigationLink { AuditTrailView() } label: {
                        Label("Immutable audit trail", systemImage: "doc.text.magnifyingglass")
                    }
                    Button {
                        Task { await store.refreshGroupWorkspace() }
                    } label: {
                        Label(store.isSyncing ? "Refreshing…" : "Refresh from central database", systemImage: "arrow.clockwise")
                    }
                    .disabled(store.isSyncing)
                }

                if store.isCurrentUserAdmin {
                    Section("Group lifecycle") {
                        NavigationLink { CreateGroupView() } label: {
                            Label("Create another carpool group", systemImage: "plus.rectangle.on.folder")
                        }
                        Text("Creating another group switches this phone to the new group. The previous group's records remain in PostgreSQL.")
                            .font(.footnote)
                            .foregroundStyle(.secondary)
                    }
                }
            } else {
                Section {
                    ContentUnavailableView(
                        "No carpool group",
                        systemImage: "person.3.sequence",
                        description: Text("Create a private group or accept an invitation from another parent.")
                    )
                    NavigationLink { CreateGroupView() } label: {
                        Label("Create a carpool group", systemImage: "plus.circle.fill")
                    }
                    NavigationLink { AcceptInvitationView() } label: {
                        Label("Accept an invitation", systemImage: "envelope.open.fill")
                    }
                }
            }
        }
        .navigationTitle("Carpool Group")
        .refreshable { await store.refreshGroupWorkspace(showSuccess: false) }
        .toolbar {
            if store.isCurrentUserAdmin {
                ToolbarItem(placement: .topBarTrailing) {
                    NavigationLink(destination: CreateGroupView()) {
                        Image(systemName: "plus.circle.fill")
                    }
                    .accessibilityLabel("Create another carpool group")
                }
            }
        }
    }

    private var activeParents: [GroupMember] {
        store.groupMembers.filter { $0.status == .active && $0.role != .viewer }
    }

    private var scheduleReady: Bool {
        guard store.calendarRegistration != nil, activeParents.count >= 2 else { return false }
        let approvedNames = Set(store.approvedConstraints.map(\.parentName))
        return activeParents.allSatisfy { approvedNames.contains($0.parentName) }
    }

    private var scheduleReadinessMessage: String {
        if store.calendarRegistration == nil {
            return "Upload the authoritative school calendar before publishing a schedule."
        }
        if activeParents.count < 2 {
            return "At least two active driving parents are required."
        }
        let approvedNames = Set(store.approvedConstraints.map(\.parentName))
        let missing = activeParents.filter { !approvedNames.contains($0.parentName) }.map(\.parentName)
        if !missing.isEmpty {
            return "Waiting for approved availability from: \(missing.joined(separator: ", "))."
        }
        return "Ready to publish."
    }

    private func roleColor(_ role: GroupRole) -> Color {
        switch role {
        case .owner: return KCPTheme.orange
        case .admin: return KCPTheme.violet
        case .parent: return KCPTheme.blue
        case .viewer: return .secondary
        }
    }
}

private struct CreateGroupView: View {
    @Environment(CarpoolStore.self) private var store
    @Environment(\.dismiss) private var dismiss
    @State private var name = "BASIS Phoenix Primary Carpool"
    @State private var schoolName = "BASIS Phoenix Primary"
    @State private var schoolKey = "basis-phoenix-primary"
    @State private var academicYear = "2026-27"

    var body: some View {
        Form {
            Section("Group") {
                TextField("Group name", text: $name)
                LabeledContent("School", value: schoolName)
                LabeledContent("Academic year", value: academicYear)
            } footer: {
                Text("The pilot schedule engine and PDF verification are locked to the user-confirmed BASIS Phoenix Primary 2026–27 calendar. Multi-school onboarding is reserved for the hosted production phase.")
            }
            Section {
                Button(store.isSyncing ? "Creating…" : "Create group") {
                    Task {
                        let created = await store.createGroup(
                            name: name,
                            schoolName: schoolName,
                            schoolKey: schoolKey,
                            academicYear: academicYear
                        )
                        if created { dismiss() }
                    }
                }
                .buttonStyle(.borderedProminent)
                .disabled(store.isSyncing || name.trimmingCharacters(in: .whitespaces).isEmpty)
            } footer: {
                Text("The creator becomes the owner. Owners and admins can invite parents, upload one authoritative calendar, review constraints and publish schedule revisions.")
            }
        }
        .navigationTitle("Create Group")
    }
}

